    "3": "Recent (2025-26) serious incidents (hijacking, attempted hijacking, shooting, armed robbery) reported by more than one source."
  },
  "_placement": {
    "ramp": "Small circles at the street end of each off-ramp found in OpenStreetMap (both directions, one group), kept clear of the freeway itself.",
    "intersection": "Circle at the OpenStreetMap junction of the two named roads.",
    "point": "Circle at the given coordinate.",
    "corridor": "Narrow strip along the road between two points (via the routing service); counts only when driven along for 500 m+.",
    "area": "Police-precinct-sized circle; counts only when driven 1 km+ inside."
  },
